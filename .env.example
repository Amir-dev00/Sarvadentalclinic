APP_NAME="کلینیک دندانپزشکی سروا"
APP_NAME_EN="Sarva Dental Clinic"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://sarvadentalclinic.ir
APP_TIMEZONE=Asia/Tehran
APP_KEY=

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4

SESSION_NAME=sarva_session
SESSION_LIFETIME=7200

# SMS: log (development) | smsir (production)
SMS_DRIVER=smsir
SMS_API_KEY=
SMS_SENDER=
SMS_OTP_TEMPLATE=
SMS_OTP_TTL=120
SMS_RESEND_COOLDOWN=60
SMS_MAX_ATTEMPTS=5

# SMS.ir — never commit real keys; copy to .env on the server
SMSIR_API_KEY=
SMSIR_LINE_NUMBER=
SMSIR_TEMPLATE_ID=
SMSIR_OTP_TEMPLATE_ID=700630
SMSIR_APPOINTMENT_REMINDER_TEMPLATE_ID=822711

# Payment: sandbox | zarinpal | idpay
PAYMENT_DRIVER=sandbox
PAYMENT_MERCHANT_ID=
PAYMENT_CALLBACK_URL=https://sarvadentalclinic.ir/payment/callback
PAYMENT_CURRENCY=IRT

OTP_LENGTH=6
APPOINTMENT_HOLD_MINUTES=15
DEFAULT_APPOINTMENT_DURATION=30
