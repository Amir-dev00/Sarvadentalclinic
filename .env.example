APP_NAME=
APP_NAME_EN=
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Tehran
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4

SESSION_NAME=sarva_session
SESSION_LIFETIME=7200

# SMS: log (development) | smsir (production)
SMS_DRIVER=log
SMS_API_KEY=
SMS_SENDER=
SMS_OTP_TEMPLATE=
SMS_OTP_TTL=300
SMS_RESEND_COOLDOWN=60
SMS_MAX_ATTEMPTS=5

# SMS.ir — never expose these to the browser
SMSIR_API_KEY=
SMSIR_LINE_NUMBER=
SMSIR_TEMPLATE_ID=

# Payment: sandbox | zarinpal | idpay
PAYMENT_DRIVER=sandbox
PAYMENT_MERCHANT_ID=
PAYMENT_CALLBACK_URL=
PAYMENT_CURRENCY=IRR

OTP_LENGTH=5
APPOINTMENT_HOLD_MINUTES=15
DEFAULT_APPOINTMENT_DURATION=30
