RewriteEngine On
DirectoryIndex index.php

# Deny sensitive paths if docroot is ever misconfigured to project root
RewriteRule ^(storage|migrations|vendor|config|includes|src|cron)/ - [F,L]
RewriteRule (^|/)\.env - [F,L]
RewriteRule (^|/)composer\.(json|lock)$ - [F,L]

# Long-cache immutable static assets
<IfModule mod_headers.c>
  <FilesMatch "\.(ico|jpg|jpeg|png|gif|webp|svg|woff2|woff|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# Serve existing files/directories directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Ensure WebP is served with the correct MIME type on cPanel/Apache
<IfModule mod_mime.c>
  AddType image/webp .webp
</IfModule>

# Front controller
RewriteRule ^ index.php [L]

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php84” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php84 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
