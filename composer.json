{
  "name": "sarva/dental-clinic",
  "description": "Sarva Dental Clinic — Persian dental clinic platform",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "phpoffice/phpspreadsheet": "^2.0",
    "vlucas/phpdotenv": "^5.6"
  },
  "autoload": {
    "psr-4": {
      "Sarva\\": "src/"
    },
    "files": [
      "includes/helpers.php",
      "includes/jalali.php"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
